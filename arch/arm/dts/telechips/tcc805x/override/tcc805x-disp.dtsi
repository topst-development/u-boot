	fb_fld0800: fb_fld0800 {
		compatible = "telechips,fb-fld0800";
		status = "disabled";

		mode = <LVDS_SINGLE>;   /* 0: single 1: dual */
		phy-ports = <PHY_PORT_S0>; /* port main, port sub */
		data-mapping = "vesa-24";
		lane-main = <DATA0_LANE DATA1_LANE DATA2_LANE CLK_LANE DATA3_LANE>;
		vcm = <1200>;
		vsw = <400>;
		pinctrl-names = "default", "lcd_on", "reset_off",
				"blk_on", "blk_off", "reset_on", "lcd_off";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		pinctrl-6 = <>;
		display-timings {
			timing0 {
				clock-frequency = <51200000>;
				hactive = <1024>;
				vactive = <600>;
				hfront-porch = <147>;
				hback-porch = <147>;
				hsync-len = <19>;
				hsync-active = <0>;
				vback-porch = <10>;
				vfront-porch = <25>;
				vsync-len = <2>;
				vsync-active = <0>;
				de-active = <1>;
				pixelclk-active = <1>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			fld0800_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				#if defined(CONFIG_SAMPLE_DTB)
				fb_lvds_single_input_0: endpoint {
					remote-endpoint = <&fb0_display_out>;
				};
				fb_lvds_single_input_0: endpoint {
					remote-endpoint = <&fb1_display_out>;
				};
				fb_lvds_single_input_0: endpoint {
					remote-endpoint = <&fb2_display_out>;
				};
				fb_lvds_single_input_0: endpoint {
					remote-endpoint = <&fb3_display_out>;
				};
				#endif
			};
		};
	};

	fb_dpv14_common_settings: fb_dpv14_common_settings {
		dp-panel-mode = <DPCFG_PANEL_MODE>;
		dp-serdes-i2c-port = <I2C_PORT_TO_SERDES>; /* For PANEL_MODE_ON */
		dp-vic = <DPCFG_DP0_VIDEO_FORMAT DPCFG_DP0_VIC>,
			 <DPCFG_DP1_VIDEO_FORMAT DPCFG_DP1_VIC>,
			 <DPCFG_DP2_VIDEO_FORMAT DPCFG_DP2_VIC>,
			 <DPCFG_DP3_VIDEO_FORMAT DPCFG_DP3_VIC>;
		dp-vcp_id = <DPCFG_DP0_VCP DPCFG_DP1_VCP DPCFG_DP2_VCP DPCFG_DP3_VCP>;
		dp-phy-lane-swap = <PHY_LANE_SWAP_ON>;
		dp-pixel-encoding = <DPCFG_ENCODING>;
		dp-max-bandwidth = <DPCFG_MAX_LANE DPCFG_RATE>;

		/* Board configuration */
		phy_model = <DPTX_PHY_DEVICE_SNPS>;
		evb_power_type = <TCC_EVB_LCD_FOUR_POW>;
	};

	fb_dpv14_0: fb_dpv14_0 {
		compatible = "telechips,fb-dpv14-panel";
		status = "disabled";

		settings = <&fb_dpv14_common_settings>;

		pinctrl-names = "default", "lcd_on", "reset_off",
				"blk_on", "blk_off", "reset_on", "lcd_off",
				"dp_hpd", "serdes_intb", "serdes_lock";
		pinctrl-0 = <>;
		pinctrl-1 = <>;
		pinctrl-2 = <>;
		pinctrl-3 = <>;
		pinctrl-4 = <>;
		pinctrl-5 = <>;
		pinctrl-6 = <>;
		pinctrl-7 = <>;
		pinctrl-8 = <>;
		pinctrl-9 = <>;
		hw-config {
			aux-hysteresis = <2>; /* hysteresis 0: 0mV, 1: 10mV, 2: 30mV, 3: 40mV */
			eq {
				status = "disabled";
				rbr {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr2 {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
				hbr3 {
					main = <0x08 0x0A 0x0C 0x10
						0x0C 0x0F 0x12 0xFF
						0x10 0x14 0xFF 0xFF
						0x18 0xFF 0xFF 0xFF>;
					post = <0x00 0x02 0x04 0x08
						0x00 0x03 0x06 0xFF
						0x00 0x04 0xFF 0xFF
						0x00 0xFF 0xFF 0xFF>;
				};
			};
		};
		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			dp14_in0: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				#if defined(CONFIG_SAMPLE_DTB)
				fb_dpv14_input_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&fb0_display_out>;
				};
				fb_dpv14_input_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&fb1_display_out>;
				};
				fb_dpv14_input_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&fb2_display_out>;
				};
				fb_dpv14_input_0: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&fb3_display_out>;
				};
				#endif
			};
		};
	};

