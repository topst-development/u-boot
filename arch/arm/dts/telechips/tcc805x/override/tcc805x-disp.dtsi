	fb_wdma: fb_wdma {
		compatible = "telechips,fb-wdma";
		status = "disabled";

		wdma = <VIOC_NO_COMPONENT>;
		mode = <1>; /* 0: Frame by frame 1: Continous */
		fb-buf-addr = <0x4B7D2000>;
		display-timings {
			timing0 {
				clock-frequency = <0>;
				hactive = <1920>;
				vactive = <720>;
				hfront-porch = <0>;
				hback-porch = <0>;
				hsync-len = <0>;
				hsync-active = <0>;
				vback-porch = <0>;
				vfront-porch = <0>;
				vsync-len = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			wdma_in: port@0 {
				#address-cells = <1>;
				#size-cells = <0>;
				reg = <0>;
				#if defined(CONFIG_SAMPLE_DTB)
				fb_wdma_input_0: endpoint {
					remote-endpoint = <&fb0_display_out>;
				};
				fb_wdma_input_0: endpoint {
					remote-endpoint = <&fb1_display_out>;
				};
				fb_wdma_input_0: endpoint {
					remote-endpoint = <&fb2_display_out>;
				};
				fb_wdma_input_0: endpoint {
					remote-endpoint = <&fb3_display_out>;
				};
				#endif
			};
		};

		async-config {
			status = "disabled";
		        fifo = <VIOC_NO_COMPONENT>;
		        rdma = <VIOC_NO_COMPONENT>;
		};
	};
};
